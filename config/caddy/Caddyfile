{
	admin off

	events {
        on cert_obtained exec /usr/local/bin/deploy-proxy-cert.sh {event.data.identifier} {event.data.certificate_path} {event.data.private_key_path}
    }

	servers :443 {
		listener_wrappers {
			layer4 {
				# Route all hostnames except NetBird management to the proxy
				@proxy_traffic not tls {
					sni {$BASE_URL}
				}

				route @proxy_traffic {
					proxy {
						proxy_protocol v2
						upstream 127.0.0.1:8443
					}
				}
			}
			tls
		}
	}
}

{$BASE_URL} {
    tls {
        issuer acme {
            email {$SSL_EMAIL}
            dns cloudflare {$CLOUDFLARE_API_TOKEN}
        }
    }

    @grpc header Content-Type application/grpc*
    reverse_proxy @grpc h2c://127.0.0.1:8081  # netbird-server

    @backend path /relay* /ws-proxy/* /api/* /oauth2/*
    reverse_proxy @backend 127.0.0.1:8081  # netbird-server
    
    reverse_proxy /* 127.0.0.1:8080  # netbird-dashboard
}

# Dummy block - Allows Caddy to issue and renew the wildcard cert.
*.{$NB_PROXY_DOMAIN} {
    tls {
        issuer acme {
            email {$SSL_EMAIL}
            dns cloudflare {$CLOUDFLARE_API_TOKEN}
        }
    }
	abort
}