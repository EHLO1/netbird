{
	admin off

	servers :443 {
		listener_wrappers {
			layer4 {
				# Hostnames terminated by Caddy @ L7 do nothing in L4 so they skip to standard Caddy TLS/HTTP
				@caddy_hosts tls sni {$BASE_URL}
				route @caddy_hosts {
				}

				# Catch-all for *.{$NB_PROXY_DOMAIN} and any Custom Domains
				route {
					proxy {
						proxy_protocol v2
						upstream 127.0.0.1:8443  # netbird-proxy
					}
				}
			}
			tls
		}
	}
}

{$BASE_URL} {
    tls {
        issuer acme {
            email {$SSL_EMAIL}
            dns cloudflare {$CLOUDFLARE_API_TOKEN}
        }
    }

    @grpc header Content-Type application/grpc*
    reverse_proxy @grpc h2c://127.0.0.1:8081  # netbird-server

    @backend path /relay* /ws-proxy/* /api/* /oauth2/*
    reverse_proxy @backend 127.0.0.1:8081  # netbird-server
    
    reverse_proxy /* 127.0.0.1:8080  # netbird-dashboard
}

# Dummy block - Allows Caddy to issue and renew the wildcard cert.
*.{$NB_PROXY_DOMAIN} {
    tls {
        issuer acme {
            email {$SSL_EMAIL}
            dns cloudflare {$CLOUDFLARE_API_TOKEN}
        }
    }
	abort
}