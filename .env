# Secrets Manager Variables:
# POSTGRES_USER
# POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# NB_AUTH_SECRET "$(openssl rand -hex 32)"
# NB_STORE_ENCRYPTION_KEY "$(openssl rand -base64 32)"
# NB_PROXY_TOKEN
# SSL_EMAIL
# CLOUDFLARE_API_TOKEN
# NB_SERVER_AUTH_OWNER_EMAIL
# NB_SERVER_AUTH_OWNER_PASSWORD

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
CADDY_IMAGE_TAG="latest"
NETBIRD_SERVER_IMAGE_TAG="latest"
NETBIRD_DASHBOARD_IMAGE_TAG="latest"
NETBIRD_PROXY_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="netbird"
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}


# --------------------------------------
# ------------  NETBIRD  ---------------
# -------------------------------------- 

#-[ Network
BASE_URL="netbird.jjcasa.net"

#-[ Secrets
NB_AUTH_SECRET=${NB_AUTH_SECRET}
NB_STORE_ENGINE_POSTGRES_DSN="host=postgres port=5432 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} sslmode=disable"
NB_STORE_ENCRYPTION_KEY=${NB_STORE_ENCRYPTION_KEY}
NB_ACTIVITY_EVENT_STORE_ENGINE="postgres"
NB_ACTIVITY_EVENT_POSTGRES_DSN="host=postgres port=5432 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} sslmode=disable"

#-[ Dashboard
NETBIRD_MGMT_API_ENDPOINT="https://${BASE_URL}"
NETBIRD_MGMT_GRPC_API_ENDPOINT="https://${BASE_URL}"
AUTH_AUDIENCE="netbird-dashboard"
AUTH_CLIENT_ID="netbird-dashboard"
AUTH_CLIENT_SECRET="" # Default is blank for use with Embedded IdP
AUTH_AUTHORITY="https://${BASE_URL}/oauth2"
USE_AUTH0="false"
AUTH_SUPPORTED_SCOPES="openid profile email groups"
AUTH_REDIRECT_URI="/nb-auth"
AUTH_SILENT_REDIRECT_URI="/nb-silent-auth"
NGINX_SSL_PORT="443"
LETSENCRYPT_DOMAIN="none"

#-[ Reverse Proxy
NB_PROXY_MANAGEMENT_ADDRESS="http://127.0.0.1:8081"
NB_PROXY_ALLOW_INSECURE="true"
NB_PROXY_DOMAIN="proxy.jjcasa.net"
NB_PROXY_TOKEN=${NB_PROXY_TOKEN}
NB_PROXY_ADDRESS="127.0.0.1:8443"
NB_PROXY_HEALTH_ADDRESS="127.0.0.1:9001"
# Required to parse PROXY protocol v2 headers sent by caddy-l4
NB_PROXY_PROXY_PROTOCOL="true"
# Trust Caddy's static container IP for PROXY protocol v2 client IP preservation
NB_PROXY_TRUSTED_PROXIES="127.0.0.1"
NB_PROXY_FORWARDED_PROTO="https"
# Keep ACME_CERTIFICATES=true! This initializes the cert manager that wires up
# NB_PROXY_WILDCARD_CERT_DIR AND allows fallback ACME for external custom domains.
NB_PROXY_ACME_CERTIFICATES="true"
NB_PROXY_ACME_CHALLENGE_TYPE="tls-alpn-01"
NB_PROXY_CERTIFICATE_DIRECTORY="/certs"
NB_PROXY_WILDCARD_CERT_DIR="/certs/wildcard"
NB_PROXY_PRIVATE="true"
CADDY_WILDCARD_DIR="./data/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/wildcard_.${NB_PROXY_DOMAIN}"

#-[ Caddy DNS-01
SSL_EMAIL=${SSL_EMAIL}
CLOUDFLARE_API_TOKEN=${CLOUDFLARE_API_TOKEN}

#-[ Future (If PR 8515 is Merged - Variables are subject to change)
