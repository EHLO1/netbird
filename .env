NETBIRD_DOMAIN=netbird.jjcasa.net
POSTGRES_USER=netbird
POSTGRES_DB=netbird
# Secrets are injected into the command environment by Doppler:
# NETBIRD_PG_PASSWORD
# NETBIRD_RELAY_SECRET
# NETBIRD_DATA_KEY
# NETBIRD_COOKIE_KEY

# Secrets Manager Variables:
# POSTGRES_USER
# POSTGRES_PASSWORD "$(openssl rand -hex 32)"
# OUTLINE_SECRET_KEY "$(openssl rand -hex 32)"
# OUTLINE_UTILS_SECRET "$(openssl rand -hex 32)"
# OUTLINE_S3_ACCESS_KEY
# OUTLINE_S3_SECRET_KEY
# OUTLINE_OIDC_ISSUER_URL
# OUTLINE_OIDC_CLIENT_ID
# OUTLINE_OIDC_CLIENT_SECRET

# --------------------------------------
# -------------  COMMON  ---------------
# --------------------------------------

#-[ Image Tags (App Versions)
POSTGRES_IMAGE_TAG="17-alpine"
NETBIRD_SERVER_IMAGE_TAG="latest"
NETBIRD_DASHBOARD_IMAGE_TAG="latest"
NETBIRD_PROXY_IMAGE_TAG="latest"
CADDY_IMAGE_TAG="latest"


# --------------------------------------
# ------------  DATABASE  --------------
# --------------------------------------

#-[ Postgres
POSTGRES_DB="netbird"
POSTGRES_ACTIVITY_DB="netbird_activity"
POSTGRES_AUTH_DB="netbird_auth"

POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}


# --------------------------------------
# ------------  NETBIRD  ---------------
# --------------------------------------

#-[ Network
BASE_URL="netbird.jjcasa.net"

#-[ Secrets
NB_AUTH_SECRET=${NB_AUTH_SECRET}
NB_STORE_ENGINE_POSTGRES_DSN="host=postgres port=5432 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} sslmode=disable"
NB_ACTIVITY_EVENT_STORE_ENGINE="postgres"
NB_ACTIVITY_EVENT_POSTGRES_DSN="host=postgres port=5432 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_ACTIVITY_DB} sslmode=disable"

#-[ Dashboard
NETBIRD_MGMT_API_ENDPOINT="https://${BASE_URL}"
NETBIRD_MGMT_GRPC_API_ENDPOINT="https://${BASE_URL}"
AUTH_AUDIENCE="netbird-dashboard"
AUTH_CLIENT_ID="netbird-dashboard"
AUTH_CLIENT_SECRET="" # Default is blank for use with Embedded IdP
AUTH_AUTHORITY="https://${BASE_URL}/oauth2"
USE_AUTH0="false"
AUTH_SUPPORTED_SCOPES="openid profile email groups"
AUTH_REDIRECT_URI="/nb-auth"
AUTH_SILENT_REDIRECT_URI="/nb-silent-auth"
NGINX_SSL_PORT="443"
LETSENCRYPT_DOMAIN="none"

#-[ Future (If PR 8515 is Merged - Variables are subject to change)
NB_SERVER_EXPOSEDADDRESS="https://${BASE_URL}:443"
NB_SERVER_AUTH_ISSUER="https://${BASE_URL}/oauth2"
NB_SERVER_AUTH_LOCALAUTHDISABLED="false"
NB_SERVER_AUTH_SIGNKEYREFRESHENABLED="true"
NB_SERVER_AUTH_SESSIONCOOKIEENCRYPTIONKEY=${NB_SERVER_AUTH_SESSIONCOOKIEENCRYPTIONKEY}
NB_SERVER_AUTH_OWNER_EMAIL=${NB_SERVER_AUTH_OWNER_EMAIL}
NB_SERVER_AUTH_OWNER_PASSWORD=${NB_SERVER_AUTH_OWNER_PASSWORD}
NB_SERVER_STORE_ENGINE="postgres"
NB_SERVER_AUTHSTORE_ENGINE="postgres"
NB_SERVER_AUTHSTORE_DSN="host=postgres port=5432 user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_AUTH_DB} sslmode=disable"
